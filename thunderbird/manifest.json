{
  "manifest_version": 3,

  "name": "Pi Thunderbird",
  "version": "0.1.1",

  "piDebug": true,

  "description": "Pi Agent for Thunderbird: multi-session ACP chat with mail tools over Native Messaging",

  "permissions": [
    "nativeMessaging",
    "storage",
    "accountsRead",
    "messagesRead",
    "compose",
    "messagesUpdate",
    "messagesMove",
    "messagesTags",
    "messagesTagsList",
    "addressBooks",
    "tabs"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "action": {
    "default_title": "Pi pane (toggle beside the message)"
  },

  "experiment_apis": {
    "piSearch": {
      "schema": "experiments/piSearch/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "piSearch"
          ]
        ],
        "script": "experiments/piSearch/implementation.js"
      }
    },
    "piPane": {
      "schema": "experiments/piPane/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "piPane"
          ]
        ],
        "script": "experiments/piPane/implementation.js"
      }
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "pi-agent-thunderbird@matbee.com",
      "strict_min_version": "128.0",
      "strict_max_version": "155.*",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}