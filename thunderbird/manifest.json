{
  "manifest_version": 3,

  "name": "Trusted User Agent for Thunderbird",
  "version": "0.4.0",

  "trustedUaDebug": true,

  "description": "Chat with pi, Claude Code or Codex in Thunderbird and let agents read, search and draft mail, with your approval. Multi-session ACP chat over Native Messaging.",

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "nativeMessaging",
    "storage",
    "accountsRead",
    "messagesRead",
    "compose",
    "messagesUpdate",
    "messagesMove",
    "messagesTags",
    "messagesTagsList",
    "addressBooks",
    "tabs"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "experiment_apis": {
    "trustedUaSearch": {
      "schema": "experiments/trustedUaSearch/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "trustedUaSearch"
          ]
        ],
        "script": "experiments/trustedUaSearch/implementation.js"
      }
    },
    "trustedUaPane": {
      "schema": "experiments/trustedUaPane/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "trustedUaPane"
          ]
        ],
        "script": "experiments/trustedUaPane/implementation.js"
      }
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "pi-agent-thunderbird@matbee.com",
      "strict_min_version": "128.0",
      "strict_max_version": "160.*",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}