{
  "name": "happy-plan-apply",
  "fixture": null,
  "pageUrl": "http://127.0.0.1:9/fixture-basic.html",
  "skillsConfig": {
    "grants": [
      {
        "skillKey": "fixture-skill/fixture-reply",
        "revision": "*",
        "capabilities": [
          "context.read",
          "suggestion.present"
        ]
      }
    ]
  },
  "job": {
    "delayMs": 10,
    "report": {
      "decision": "suggest",
      "explanation": "Draft is safe to submit.",
      "replacementText": "Fixture reply: Planning a hike"
    }
  },
  "steps": [
    {
      "side": "agent",
      "type": "prompt",
      "text": "REVIEW"
    },
    {
      "side": "agent",
      "type": "say",
      "text": "reviewing the fixture draft"
    },
    {
      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_plan",
      "params": {
        "source": {
          "application": "firefox",
          "connectionEpoch": "epoch-1",
          "documentGeneration": "gen-1",
          "tabId": 1,
          "frameId": 0
        },
        "url": "{{page_url}}"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_event",
      "params": {
        "event": {
          "version": 1,
          "eventId": "evt-happy-1",
          "event": "fixture-skill:before-submit",
          "source": {
            "application": "firefox",
            "connectionEpoch": "epoch-1",
            "documentGeneration": "gen-1",
            "tabId": 1,
            "frameId": 0
          },
          "interactionId": "int-happy-1",
          "draftRevision": 1,
          "contextRevision": 1,
          "planVersion": "{{prev.plan.planVersion}}",
          "origin": "user",
          "contextRef": "ctx-happy-1"
        }
      },
      "expect": {
        "status": "accepted"
      },
      "expectResult": {
        "status": "done",
        "decision": "suggest",
        "replacementText": "Fixture reply: Planning a hike"
      }
    },
    {
      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_status",
      "params": {},
      "expect": {
        "available": true,
        "plans": 1
      }
    }
  ],
  "expect": {
    "results": 1,
    "note": "plan -> armed rule -> gate event -> isolated job (scripted) -> identity-bound result delivered to the client"
  }
}
