      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_plan",
      "params": {
        "source": {
          "application": "firefox",
          "connectionEpoch": "epoch-1",
          "documentGeneration": "gen-1",
          "tabId": 1,
          "frameId": 0
        },
        "url": "{{page_url}}"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_event",
      "params": {
        "event": {
          "version": 1,
          "eventId": "evt-stale-1",
          "event": "fixture-skill:before-submit",
          "source": {
            "application": "firefox",
            "connectionEpoch": "epoch-1",
            "documentGeneration": "gen-1",
            "tabId": 1,
            "frameId": 0
          },
          "interactionId": "int-stale-1",
          "draftRevision": 1,
          "contextRevision": 1,
          "planVersion": 1,
          "origin": "user",
          "contextRef": "ctx-stale-1"
        }
      },
      "expect": {
        "status": "accepted"
      },
      "expectResult": {
        "status": "done",
        "decision": "clear"
      }
    },
    {
      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_plan",
      "params": {
        "source": {
          "application": "firefox",
          "connectionEpoch": "epoch-1",
          "documentGeneration": "gen-1",
          "tabId": 1,
          "frameId": 0
        },
        "url": "{{page_url}}"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_event",
      "params": {
        "event": {
          "version": 1,
          "eventId": "evt-stale-2",
          "event": "fixture-skill:before-submit",
          "source": {
            "application": "firefox",
            "connectionEpoch": "epoch-1",
            "documentGeneration": "gen-1",
            "tabId": 1,
            "frameId": 0
          },
          "interactionId": "int-stale-2",
          "draftRevision": 2,
          "contextRevision": 2,
          "planVersion": 1,
          "origin": "user",
          "contextRef": "ctx-stale-2"
        }
      },
      "expectStalePlan": true
    },
    {
      "side": "client",
      "type": "extended",
      "method": "x-trusted-ua/skills_status",
      "params": {},
      "expect": {
        "available": true,
        "plans": 1
      }
    }
