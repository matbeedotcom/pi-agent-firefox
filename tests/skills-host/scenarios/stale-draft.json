        "capabilities": [
          "context.read",
          "suggestion.present"
        ]
      }
    ]
  },
  "job": {
    "delayMs": 10,
    "report": {
      "decision": "clear",
      "explanation": "Draft is fine."
    }
  },
  "steps": [
