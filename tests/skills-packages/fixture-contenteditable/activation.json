{
  "schemaVersion": 2,
  "packageId": "fixture-contenteditable",
  "application": "firefox",
  "hosts": ["127.0.0.1"],
  "targets": {
    "composer": "div[data-skill-fixture=\"composer\"][contenteditable]",
    "submit": "button[data-skill-fixture=\"submit\"]",
    "targetEl": "[data-skill-fixture=\"target\"]"
  },
  "events": {
    "draft.paused": {
      "kind": "debounced",
      "debounceMs": 250,
      "suspendDuringComposition": true,
      "sequence": [{ "dom": "input", "target": "composer" }],
      "payload": {
        "draft": { "from": "composer", "field": "text" },
        "replyTarget": { "from": "targetEl", "field": "text", "resolve": "document" }
      }
    },
    "before-submit": {
      "kind": "gate",
      "chainId": "fixture-contenteditable-submit",
      "alternatives": [[{ "dom": "click", "target": "submit" }]],
      "payload": {
        "draft": { "from": "composer", "field": "text" },
        "replyTarget": { "from": "targetEl", "field": "text", "resolve": "document" }
      }
    }
  },
  "skills": [
    {
      "id": "reply",
      "type": "triggered",
      "instructions": "reply/SKILL.md",
      "subscriptions": [
        { "event": "draft.paused", "conditions": { "minCharacters": 1 } },
        { "event": "before-submit" }
      ],
      "context": {
        "required": ["draft"],
        "optional": ["replyTarget"]
      },
      "review": {
        "defaultMode": "review-before-submit"
      },
      "capabilities": ["context.read", "suggestion.present", "draft.replace-on-accept"],
      "execution": {
        "handler": "agent",
        "timeoutMs": 10000
      }
    }
  ]
}
