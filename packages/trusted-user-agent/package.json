{
  "name": "trusted-user-agent",
  "version": "0.5.0",
  "type": "module",
  "description": "Trusted user agents for AI agents: Firefox and Thunderbird tools for any MCP client (Claude Code, Codex, Cursor, Gemini CLI, VS Code, pi), with per-app approval. Native Messaging host com.matbee.agent + ACP adapter for pi.",
  "keywords": [
    "pi-package",
    "mcp",
    "firefox",
    "thunderbird",
    "native-messaging",
    "acp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matbeedotcom/pi-agent-firefox.git",
    "directory": "packages/trusted-user-agent"
  },
  "homepage": "https://github.com/matbeedotcom/pi-agent-firefox#readme",
  "bin": {
    "trusted-ua": "dist/installer/cli.js"
  },
  "main": "./dist/native-host/main.js",
  "pi": {
    "extensions": [
      "extensions"
    ]
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map",
    "extensions",
    "skills",
    "native/trusted-ua-host",
    "native/pi-browser-host",
    "native/pi-browser-host.cmd"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test \"dist-tests/test/**/*.test.js\"",
    "prepack": "node scripts/bundle-protocol.mjs copy",
    "postpack": "node scripts/bundle-protocol.mjs clean"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@trusted-ua/protocol": "0.5.0",
    "typebox": "^1.1.32",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "bundleDependencies": [
    "@trusted-ua/protocol"
  ]
}
