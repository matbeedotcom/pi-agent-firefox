{
  "name": "@pi-browser/webext",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Shared WebExtension-side ACP client + session store for the Mozilla add-ons (Firefox, Thunderbird)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test dist-tests/test/*.test.js"
  },
  "dependencies": {
    "@pi-browser/protocol": "0.1.1",
    "streaming-markdown": "^0.2.15"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "typescript": "^5.6.0"
  }
}
